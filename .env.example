# ==========================================
# Telegram Bot Configuration
# ==========================================
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ==========================================
# OpenAI / LLM Configuration
# ==========================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Опционально: если используется прокси или совместимый эндпоинт (OpenRouter, DeepSeek и др.)
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# ==========================================
# Google Sheets API Configuration
# ==========================================
# Путь к JSON-файлу сервисного аккаунта Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=data/service_account.json
# ID таблицы из URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
# Название листа в таблице
GOOGLE_SHEET_NAME=Лист1
# Прямая ссылка на таблицу для удобства мастера (кнопка в боте)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit

# ==========================================
# Bitrix24 REST API / Webhook Configuration
# ==========================================
# URL входящего вебхука с правами на 'tasks' (Управление задачами)
# Создается в: Битрикс24 -> Разработчикам -> Другое -> Входящий веб-хук
BITRIX24_WEBHOOK_URL=https://b24-xxxxxx.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/
# ID ответственного сотрудника в Битрикс24
BITRIX24_RESPONSIBLE_ID=1

# ==========================================
# Application Settings
# ==========================================
TIMEZONE=Europe/Moscow
CACHE_TTL_SECONDS=300
FALLBACK_CSV_PATH=data/sample_estimate.csv
